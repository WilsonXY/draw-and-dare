doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Final Results - Draw and Dare
    link(rel="stylesheet", href="/css/style.css")
  body
    .container
      h1 Game Over! Final Results
      
      if leaderboard && leaderboard.length > 0
        table.leaderboard-table
          thead
            tr
              th Rank
              th Player
              th Score
          tbody
            each player, index in leaderboard
              tr
                td #{index + 1}
                td #{player.username}
                td #{player.current_score}
      else
        p No players joined this game.
        
      a.btn(href="/") Back to Main Menu