extends layout

block content
  .lobby-container
    // Left/Top Side: Participants
    .participants-section
      h2 Participants
      ul#participants-list.list-box
        // Example dynamic rendering
        each player in players || []
          li= player.username
        if (!players || players.length === 0)
          li Waiting for players...

    // Right/Bottom Side: Game Info
    .info-section
      .code-display
        h3 Lobby Code
        .code-box #{lobby_code || '------'}
      
      .qr-display
        h3 QR Code
        // Placeholder for generated QR
        .qr-placeholder [ QR Code Here ]
      
      if isHost
        button.btn.btn-start#start-game-btn Start!