extends layout

block content
  .host-dashboard
    // Top Section: Currently Answering Player (Question Board)
    .question-board-container
      h2.question-board-title Question Board
      .question-display
        h3#current-question Waiting for a player to scan an Enemy Card...
      .answer-pad
        ul#current-options
          li.option No active question
      p.answering-status Answering by: 
        span#active-player-name ...

    // Bottom/Side Section: Leaderboard
    .leaderboard-container
      h2 Players Ranking
      table.ranking-table
        thead
          tr
            th Rank
            th Username
            th Score
        tbody#ranking-body
          tr
            td 1
            td WeeGamer
            td 1520
      
      h3.game-log-title Game Log
      .game-log-container
        ul#game-log
          li WeeGamer drew an Enemy Card!
          li WeeGamer answered correctly (+20 pts).

      button.btn.btn-danger#end-game-btn End Game

    // BGM
    #bgm-container
      audio#bgm-audio(loop autoplay)
        source(src="/audio/走り出せ世界 - Nyalpaca BGM Workshop.mp3" type="audio/mpeg")
      input#bgm-volume-slider(type="range" min="0" max="1" step="0.01" value="0.2")
      button#bgm-toggle-btn(title="Toggle Music") 🔊

  script(src="/js/host.js")